<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- 
    Selenium POM Test Suite Configuration
    - Parallel execution: methods run in parallel with 3 threads
    - Browser can be overridden via parameter
    - Listeners can be added for reporting
-->
<suite name="Selenium POM Test Suite" parallel="methods" thread-count="3" verbose="1">
    
    <!-- Suite-level parameters (can be overridden from command line) -->
    <parameter name="browser" value="chrome"/>
    
    <!-- Add listeners here for reporting (uncomment as needed) -->
    <!-- <listeners>
        <listener class-name="org.testng.reporters.EmailableReporter"/>
        <listener class-name="org.testng.reporters.JUnitReportReporter"/>
    </listeners> -->
    
    <!-- Test App Tests -->
    <test name="Test App Tests">
        <classes>
            <class name="com.test.org.tests.TestAppTest"/>
        </classes>
    </test>
    
    <!-- Home Page Tests (uncomment when created) -->
    <!-- <test name="Home Page Tests">
        <classes>
            <class name="com.test.org.tests.HomePageTest"/>
        </classes>
    </test> -->
    
    <!-- Add more test tags here for additional test classes -->
    <!-- Example structure:
    <test name="Your Test Name">
        <classes>
            <class name="com.test.org.tests.YourTestClass"/>
        </classes>
    </test>
    -->
    
</suite>
